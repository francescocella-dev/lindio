{
  "name": "lindio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:pwa": "playwright test --config=playwright.pwa.config.js",
    "check:bundle": "node scripts/check-build-output.mjs",
    "check:release": "node scripts/check-release-hygiene.mjs",
    "quality:deploy": "npm run build && npm run check:bundle && npm run check:release",
    "quality:frontend": "npm run lint && npm run typecheck && npm run test:unit && npm run quality:deploy",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "db:lint": "supabase db lint --local --level warning --fail-on error"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "esbuild": "0.28.1",
    "eslint": "10.8.1",
    "supabase": "2.110.0",
    "typescript": "5.8.3",
    "vite": "7.3.6"
  }
}
