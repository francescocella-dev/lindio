# Lindio can run without Supabase by using the explicit local demo mode.
#
# For database-backed mode, point these variables to either:
# - the local Supabase stack started with `npx supabase start`, or
# - a hosted Supabase project.
#
# Only use the browser-safe publishable/anon key here. Never expose a
# Supabase service-role key through a VITE_* variable or commit real keys.

VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
